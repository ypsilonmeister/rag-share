# Copy to rag-share.env and edit. Loaded by the systemd units via
# EnvironmentFile, or sourced in your shell before running the scripts.

# Public HTTPS origin of the server (OAuth issuer / resource URI).
# Keep the localhost default while testing locally.
RAG_SHARE_PUBLIC_BASE=https://your-host.example

# Comma-separated bind addresses for server.py.
RAG_SHARE_BIND_HOSTS=127.0.0.1

# Listen port.
RAG_SHARE_PORT=8790

# Queries are private by default. Set 1 only if query text logging is needed.
RAG_SHARE_LOG_QUERIES=0
# Size per log file; retain this many rotated backups (1..10).
RAG_SHARE_LOG_MAX_BYTES=1048576
RAG_SHARE_LOG_BACKUPS=3

# Application-wide POST limits, shared across all clients (single process).
RAG_SHARE_REGISTER_PER_MINUTE=10
RAG_SHARE_AUTHORIZE_PER_MINUTE=10
RAG_SHARE_TOKEN_PER_MINUTE=60
RAG_SHARE_OAUTH_BODY_LIMIT=16384
RAG_SHARE_OAUTH_MAX_CLIENTS=100

# Google Drive folder ID that pull.py mirrors (required for pull.py).
RAG_SHARE_FOLDER_ID=

# Data directory for both server.py and pull.py: corpus/, tokens,
# OAuth state, model cache and logs live here.
# Default: the script's own directory. The Docker image sets /data.
# RAG_SHARE_DIR=/path/to/data
